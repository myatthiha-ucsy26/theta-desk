# Copy to .env and fill in. The .env file is git-ignored.
# Anything already exported in your shell wins over this file.

# Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AI trade review. Any Anthropic-compatible endpoint. There is no default:
# the review stays off until all three are set. The Settings screen lists some
# providers and the models each serves, or fill them in here.
AI_API_KEY=
AI_API_ENDPOINT=
AI_MODEL=

# Optional
# OPEND_HOST=127.0.0.1
# OPEND_PORT=11111
# PORT=5057
# CS_DB_PATH=data/engine.db
